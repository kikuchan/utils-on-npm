{
  "name": "@kikuchan/utils-on-npm",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm run clean; pnpm -r run build",
    "clean": "rm -rf ./dist",
    "format": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest --run && pnpm -r run type:check",
    "coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*"
  ]
}
