{
  "name": "@kikuchan/utils-on-npm",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm run clean; pnpm -r run build",
    "clean": "rm -rf ./dist",
    "format": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest --run && pnpm -r run type:check",
    "coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*"
  ]
}
